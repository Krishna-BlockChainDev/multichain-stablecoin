{
	"name": "evm-upgradeable",
	"version": "1.0.0",
	"scripts": {
		"help": "npx hardhat help",
		"accounts": "npx hardhat accounts",
		"node": "npx hardhat node",
		"clean": "npx hardhat clean",
		"test": "npx hardhat test",
		"coverage": "npx hardhat coverage",
		"compile": "npx hardhat compile",
		"deploy:hardhat": "npx hardhat run scripts/deploy.ts --network hardhat",
		"deploy:mainnet": "npx hardhat run scripts/deploy.ts --network mainnet",
		"deploy:sepolia": "npx hardhat run scripts/deploy.ts --network sepolia",
		"deploy:bsc": "npx hardhat run scripts/deploy.ts --network bsc",
		"deploy:bsctestnet": "npx hardhat run scripts/deploy.ts --network bsctestnet",
		"deploy:avalanche": "npx hardhat run scripts/deploy.ts --network avalanche",
		"deploy:avalancheFuji": "npx hardhat run scripts/deploy.ts --network avalancheFuji",
		"deploy:polygon": "npx hardhat run scripts/deploy.ts --network polygon",
		"deploy:polygonAmoy": "npx hardhat run scripts/deploy.ts --network polygonAmoy",
		"deploy:fantom": "npx hardhat run scripts/deploy.ts --network fantom",
		"deploy:fantomTestnet": "npx hardhat run scripts/deploy.ts --network fantomTestnet",
		"deploy:celo": "npx hardhat run scripts/deploy.ts --network celo",
		"deploy:celoAlfajores": "npx hardhat run scripts/deploy.ts --network celoAlfajores",
		"verify:mainnet": "npx hardhat verify --network mainnet",
		"verify:sepolia": "npx hardhat verify --network sepolia",
		"verify:bsc": "npx hardhat verify --network bsc",
		"verify:bsctestnet": "npx hardhat verify --network bsctestnet",
		"verify:avalanche": "npx hardhat verify --network avalanche",
		"verify:avalancheFuji": "npx hardhat verify --network avalancheFuji",
		"verify:polygon": "npx hardhat verify --network polygon",
		"verify:polygonAmoy": "npx hardhat verify --network polygonAmoy",
		"verify:fantom": "npx hardhat verify --network fantom",
		"verify:fantomTestnet": "npx hardhat verify --network fantomTestnet",
		"verify:celo": "npx hardhat verify --network celo",
		"verify:celoAlfajores": "npx hardhat verify --network celoAlfajores",
		"test:gas": "npx hardhat test --gas",
		"gas-report": "npx hardhat test --network hardhat --report-gas",
		"lint": "eslint '**/*.{ts,tsx}' --fix",
		"format": "prettier --write '**/*.{ts,tsx,json,md,yml}'",
		"lint:sol": "solhint 'contracts/**/*.sol'",
		"lint:sol:fix": "solhint 'contracts/**/*.sol' --fix"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
		"@nomicfoundation/hardhat-verify": "^2.0.13",
		"@openzeppelin/contracts": "5.2.0",
		"@openzeppelin/contracts-upgradeable": "^4.9.3",
		"@openzeppelin/contracts-v5": "npm:@openzeppelin/contracts@5.1.0",
		"@openzeppelin/hardhat-upgrades": "^3.9.0",
		"@openzeppelin/test-helpers": "^0.5.16",
		"@types/chai": "^4.2.22",
		"@types/mocha": "^9.0.0",
		"@typescript-eslint/eslint-plugin": "^5.3.1",
		"@typescript-eslint/parser": "^5.3.1",
		"chai": "^4.3.4",
		"dotenv": "^16.3.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-node": "^11.1.0",
		"eth-permit": "^0.2.3",
		"ethers": "^6.13.5",
		"hardhat": "^2.21.0",
		"solhint": "^5.0.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.0",
		"web3": "^1.10.4"
	},
	"dependencies": {
		"@fireblocks/fireblocks-web3-provider": "^1.3.18",
		"@fireblocks/hardhat-fireblocks": "^1.3.6"
	}
}
